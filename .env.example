JIZHANG_ENV=dev
JIZHANG_HOST=127.0.0.1
JIZHANG_PORT=8000
JIZHANG_TRANSPORT=http
JIZHANG_DATABASE_URL=postgresql+asyncpg://jizhang:jizhang@127.0.0.1:5432/jizhang
JIZHANG_JWT_SECRET=change-me-to-a-long-random-string-in-production
JIZHANG_JWT_EXPIRE_MINUTES=10080
JIZHANG_CORS_ORIGINS=http://127.0.0.1:5173
JIZHANG_PUBLIC_MCP_URL=http://127.0.0.1:8000/mcp
# 反向代理示例：MCP 独立前缀 /jizhangmcp → 应用内 /mcp；REST /jizhangapi → /api
JIZHANG_ASGI_ROOT_PATH=/jizhangapi
# OpenAPI Try it out 基址：含 /api，不含 /v1（与 paths 中 /v1/... 拼接）
JIZHANG_PUBLIC_API_BASE=https://yunqingkeji.site/jizhangapi/api
JIZHANG_TIMEZONE=Asia/Shanghai
JIZHANG_PASSPHRASE_TTL_SECONDS=7200
JIZHANG_AUTH_MAX_FAILURES=5
JIZHANG_AUTH_LOCKOUT_SECONDS=300
JIZHANG_REGISTER_RATE_PER_HOUR=10
JIZHANG_TRUSTED_PROXY_HOPS=0
JIZHANG_API_KEY_MAX_ACTIVE=10
JIZHANG_SCHEDULER_INTERVAL_SECONDS=60
JIZHANG_LOG_LEVEL=INFO
